y     = "Expectativa de vida media",
color = "Status do pais",
title = "Evolucao da expectativa de vida por status do pais"
) +
theme_minimal()
# Matriz de correlacao para subconjunto de variaveis
vars_corr <- dados %>%
select(
Expectativa_Vida,
Mortalidade_Adulto,
Mortalidade_Infantil,
IMC,
HIV_AIDS,
PIB,
Composicao_Renda_Recursos,
Escolaridade,
Magreza_1_19_Anos,
Magreza_5_9_Anos
) %>%
drop_na(Expectativa_Vida)
# Calcula matriz de correlacao
cor_mat <- cor(vars_corr, use = "pairwise.complete.obs")
# Grafico de correlacao com ggcorrplot
ggcorrplot(
cor_mat,
lab       = TRUE,   # mostra os valores
lab_size  = 2.5,    # diminui o tamanho dos numeros
type      = "lower",
show.diag = TRUE
) +
labs(
title = "Matriz de correlacao das variaveis selecionadas"
) +
theme_minimal() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1)  # gira os nomes das variaveis
)
dados_selecionados <- dados %>%
select(`Life expectancy`, `Adult Mortality`,Schooling,Population) %>%
head(5)
# Resumo geral da base
resumo_geral <- dados %>%
summarise(
n_obs    = n(),
n_paises = n_distinct(Pais),
ano_min  = min(Ano, na.rm = TRUE),
ano_max  = max(Ano, na.rm = TRUE)
)
kable(
resumo_geral,
caption = "Resumo geral da base de dados"
) %>%
kable_styling(full_width = FALSE)
# Quantidade e percentual de NA por variável
na_por_var <- dados %>%
summarise(across(everything(), ~ sum(is.na(.)))) %>%
pivot_longer(
cols      = everything(),
names_to  = "Variavel",
values_to = "N_NA"
) %>%
mutate(Perc_NA = 100 * N_NA / nrow(dados)) %>%
arrange(desc(Perc_NA))
kable(
na_por_var,
caption = "Quantidade e percentual de valores faltantes por variável",
digits  = 2
) %>%
kable_styling(full_width = FALSE)
# Resumo descritivo da variável resposta
resumo_expectativa <- dados %>%
summarise(
n       = sum(!is.na(Expectativa_Vida)),
media   = mean(Expectativa_Vida, na.rm = TRUE),
sd      = sd(Expectativa_Vida, na.rm = TRUE),
min     = min(Expectativa_Vida, na.rm = TRUE),
q1      = quantile(Expectativa_Vida, 0.25, na.rm = TRUE),
mediana = median(Expectativa_Vida, na.rm = TRUE),
q3      = quantile(Expectativa_Vida, 0.75, na.rm = TRUE),
max     = max(Expectativa_Vida, na.rm = TRUE)
)
kable(
resumo_expectativa,
caption = "Resumo descritivo da variável Expectativa_Vida",
digits  = 2
) %>%
kable_styling(full_width = FALSE)
# Comparação da expectativa de vida por status do país
resumo_status <- dados %>%
group_by(Status_Pais) %>%
summarise(
n       = sum(!is.na(Expectativa_Vida)),
media   = mean(Expectativa_Vida, na.rm = TRUE),
sd      = sd(Expectativa_Vida, na.rm = TRUE),
min     = min(Expectativa_Vida, na.rm = TRUE),
q1      = quantile(Expectativa_Vida, 0.25, na.rm = TRUE),
mediana = median(Expectativa_Vida, na.rm = TRUE),
q3      = quantile(Expectativa_Vida, 0.75, na.rm = TRUE),
max     = max(Expectativa_Vida, na.rm = TRUE),
.groups = "drop"
)
kable(
resumo_status,
caption = "Resumo da Expectativa_Vida por Status do país",
digits  = 2
) %>%
kable_styling(full_width = FALSE)
# Evolucao temporal por Status_Pais
le_ano_status <- dados %>%
group_by(Ano, Status_Pais) %>%
summarise(
media_le = mean(Expectativa_Vida, na.rm = TRUE),
.groups  = "drop"
)
ggplot(le_ano_status, aes(x = Ano, y = media_le, color = Status_Pais)) +
geom_line() +
geom_point() +
labs(
x     = "Ano",
y     = "Expectativa de vida media",
color = "Status do pais",
title = "Evolucao da expectativa de vida por status do pais"
) +
theme_minimal()
