geom_point(aes(x = galton$parent, y = galton$child))
ggplot(data = galton) +
geom_point(aes(x = parent, y = child))
ggplot(data = galton, aes(x = parent, y = child)) +
geom_point() +                      # Pontos de dispersão
geom_smooth(method = "lm")
ggplot(data = galton, aes(x = parent, y = child)) +
geom_point(alpha = 0.6,             # Pontos semi-transparentes
color = "blue") +
geom_smooth(method = "lm",          # Método linear
se = TRUE,              # Mostra intervalo confiança
color = "red",          # Cor da linha
fill = "lightpink")     # Cor do intervalo
ggplot(galton, aes(x = parent, y = child)) +
geom_point(alpha = 0.5,
color = "steelblue",
