resumo_geral <- dados %>%
summarise(
`Nº total de observações` = n(),
`Nº de países` = n_distinct(Pais),
`Ano inicial` = min(Ano, na.rm = TRUE),
`Ano final` = max(Ano, na.rm = TRUE),
`Período (anos)` = max(Ano, na.rm = TRUE) - min(Ano, na.rm = TRUE) + 1
) %>%
mutate(`Ano inicial` = as.integer(`Ano inicial`),
`Ano final` = as.integer(`Ano final`))
kable(
resumo_geral,
caption = "Resumo Geral da Base de Dados",
align = c('c', 'c', 'c', 'c', 'c')
) %>%
kable_styling(
full_width = FALSE,
bootstrap_options = c("striped", "hover", "condensed"),
font_size = 12,
position = "center"
) %>%
add_header_above(c(" " = 1, " " = 1, "Cobertura Temporal" = 3)) %>%
footnote(
general = "Dados referentes ao período 2000-2015, abrangendo 193 países",
general_title = "Nota:",
footnote_as_chunk = TRUE
)
