# Modelo com apenas X2 (modelo reduzido)
modelo_X2 <- lm(Y ~ X2, data = dados)
# Modelo com X2, X1 e X3 (modelo completo)
modelo_completo <- lm(Y ~ X2 + X1 + X3, data = dados)
# Somas de quadrados dos resíduos
SSE_reduzido <- sum(residuals(modelo_X2)^2)
SSE_completo <- sum(residuals(modelo_completo)^2)
# Coeficiente de determinação parcial
R2_parcial <- (SSE_reduzido - SSE_completo) / SSE_reduzido
cat("SSE (modelo com X2):", round(SSE_reduzido, 4), "\n")
cat("SSE (modelo com X1, X2, X3):", round(SSE_completo, 4), "\n")
cat("Coeficiente de determinação parcial R²(Y ~ X1, X3 | X2):", round(R2_parcial, 4), "\n")
# Método alternativo usando R²
R2_X2 <- summary(modelo_X2)$r.squared
R2_completo <- summary(modelo_completo)$r.squared
R2_parcial_alt <- (R2_completo - R2_X2) / (1 - R2_X2)
cat("Verificação alternativa:", round(R2_parcial_alt, 4), "\n")
# Modelos alternativos considerados
modelo_X2 <- lm(Y ~ X2, data = dados)                    # Melhor preditor individual
modelo_X1_X2 <- lm(Y ~ X1 + X2, data = dados)           # Duas melhores variáveis
modelo_X1_X3 <- lm(Y ~ X1 + X3, data = dados)           # Alternativa sem X2
modelo_completo <- lm(Y ~ X1 + X2 + X3, data = dados)   # Modelo completo
# Tabela comparativa
comparacao_modelos <- data.frame(
Modelo = c("Y ~ X2", "Y ~ X1 + X2", "Y ~ X1 + X3", "Y ~ X1 + X2 + X3"),
R2 = c(summary(modelo_X2)$r.squared,
summary(modelo_X1_X2)$r.squared,
summary(modelo_X1_X3)$r.squared,
summary(modelo_completo)$r.squared),
R2_ajustado = c(summary(modelo_X2)$adj.r.squared,
summary(modelo_X1_X2)$adj.r.squared,
summary(modelo_X1_X3)$adj.r.squared,
summary(modelo_completo)$adj.r.squared),
AIC = c(AIC(modelo_X2),
AIC(modelo_X1_X2),
AIC(modelo_X1_X3),
AIC(modelo_completo))
)
print(comparacao_modelos)
