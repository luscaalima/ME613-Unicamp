```{r}
# Ajustar todos os modelos candidatos
modelo_X1 <- lm(Y ~ X1, data = dados)
modelo_X2 <- lm(Y ~ X2, data = dados)
modelo_X3 <- lm(Y ~ X3, data = dados)
modelo_X1_X2 <- lm(Y ~ X1 + X2, data = dados)
modelo_X1_X3 <- lm(Y ~ X1 + X3, data = dados)
modelo_X2_X3 <- lm(Y ~ X2 + X3, data = dados)
modelo_completo <- lm(Y ~ X1 + X2 + X3, data = dados)
# Função para extrair estatísticas do modelo
extrair_estatisticas <- function(modelo, nome) {
resumo <- summary(modelo)
anova_modelo <- anova(modelo)
data.frame(
Modelo = nome,
R2 = round(resumo$r.squared, 4),
R2_Ajustado = round(resumo$adj.r.squared, 4),
AIC = round(AIC(modelo), 2),
BIC = round(BIC(modelo), 2),
F_Global = round(anova_modelo$F[1], 2),
p_valor_F = format.pval(anova_modelo$`Pr(>F)`[1], digits = 3),
SSE = round(sum(residuals(modelo)^2), 2),
Num_Preditores = length(coef(modelo)) - 1,
Selecionado = ifelse(nome == "Y ~ X2", "★ RECOMENDADO", "")
)
}
# Criar tabela comparativa
tabela_comparacao <- rbind(
extrair_estatisticas(modelo_X1, "Y ~ X1"),
extrair_estatisticas(modelo_X2, "Y ~ X2"),
extrair_estatisticas(modelo_X3, "Y ~ X3"),
extrair_estatisticas(modelo_X1_X2, "Y ~ X1 + X2"),
extrair_estatisticas(modelo_X1_X3, "Y ~ X1 + X3"),
extrair_estatisticas(modelo_X2_X3, "Y ~ X2 + X3"),
extrair_estatisticas(modelo_completo, "Y ~ X1 + X2 + X3")
)
# Ordenar por R² Ajustado (decrescente)
tabela_comparacao <- tabela_comparacao[order(-tabela_comparacao$R2_Ajustado), ]
# Exibir tabela formatada
print(tabela_comparacao, row.names = FALSE)
# Ajustar os modelos
modelo_X2 <- lm(Y ~ X2, data = dados)
modelo_X1_X2 <- lm(Y ~ X1 + X2, data = dados)
modelo_X1_X3 <- lm(Y ~ X1 + X3, data = dados)
modelo_completo <- lm(Y ~ X1 + X2 + X3, data = dados)
# Criar tabela comparativa
comparacao_modelos <- data.frame(
Modelo = c("Y ~ X2", "Y ~ X1 + X2", "Y ~ X1 + X3", "Y ~ X1 + X2 + X3"),
R2 = c(
round(summary(modelo_X2)$r.squared, 4),
round(summary(modelo_X1_X2)$r.squared, 4),
round(summary(modelo_X1_X3)$r.squared, 4),
round(summary(modelo_completo)$r.squared, 4)
),
R2_ajustado = c(
round(summary(modelo_X2)$adj.r.squared, 4),
round(summary(modelo_X1_X2)$adj.r.squared, 4),
round(summary(modelo_X1_X3)$adj.r.squared, 4),
round(summary(modelo_completo)$adj.r.squared, 4)
),
AIC = c(
round(AIC(modelo_X2), 2),
round(AIC(modelo_X1_X2), 2),
round(AIC(modelo_X1_X3), 2),
round(AIC(modelo_completo), 2)
),
Selecao = c("RECOMENDADO", "", "", "")
)
# Ordenar por R² ajustado (decrescente)
comparacao_modelos <- comparacao_modelos[order(-comparacao_modelos$R2_ajustado), ]
# Exibir tabela formatada
knitr::kable(comparacao_modelos,
align = c('l', 'c', 'c', 'c', 'l'),
col.names = c('Modelo', 'R²', 'R² Ajustado', 'AIC', 'Seleção'),
caption = "Tabela Comparativa de Modelos para Predição do Percentual de Gordura Corporal")
# Modelos alternativos considerados
modelo_X2 <- lm(Y ~ X2, data = dados)                    # Melhor preditor individual
modelo_X1_X2 <- lm(Y ~ X1 + X2, data = dados)           # Duas melhores variáveis
modelo_X1_X3 <- lm(Y ~ X1 + X3, data = dados)           # Alternativa sem X2
modelo_completo <- lm(Y ~ X1 + X2 + X3, data = dados)   # Modelo completo
# Tabela comparativa
comparacao_modelos <- data.frame(
Modelo = c("Y ~ X2", "Y ~ X1 + X2", "Y ~ X1 + X3", "Y ~ X1 + X2 + X3"),
R2 = c(
summary(modelo_X2)$r.squared,
summary(modelo_X1_X2)$r.squared,
summary(modelo_X1_X3)$r.squared,
summary(modelo_completo)$r.squared
),
R2_ajustado = c(
summary(modelo_X2)$adj.r.squared,
summary(modelo_X1_X2)$adj.r.squared,
summary(modelo_X1_X3)$adj.r.squared,
summary(modelo_completo)$adj.r.squared
),
AIC = c(
AIC(modelo_X2),
AIC(modelo_X1_X2),
AIC(modelo_X1_X3),
AIC(modelo_completo)
)
)
# Arredondar valores para melhor apresentação
comparacao_modelos$R2 <- round(comparacao_modelos$R2, 4)
comparacao_modelos$R2_ajustado <- round(comparacao_modelos$R2_ajustado, 4)
comparacao_modelos$AIC <- round(comparacao_modelos$AIC, 2)
# Adicionar coluna de recomendação
comparacao_modelos$Recomendacao <- ifelse(comparacao_modelos$Modelo == "Y ~ X2",
"RECOMENDADO", "")
# Ordenar por R² ajustado (decrescente)
comparacao_modelos <- comparacao_modelos[order(-comparacao_modelos$R2_ajustado), ]
# Exibir tabela
print(comparacao_modelos, row.names = FALSE)
library(knitr)
# Criar tabela formatada para o relatório
kable(comparacao_modelos,
align = c('l', 'r', 'r', 'r', 'l'),
col.names = c('Modelo', 'R²', 'R² Ajustado', 'AIC', 'Recomendação'),
caption = "Tabela Comparativa dos Modelos de Regressão para Predição do Percentual de Gordura Corporal")
par(mfrow = c(2, 3), mar = c(4, 4, 2, 2))
# 1. Resíduos vs Valores Ajustados
plot(valores_ajustados, residuos,
xlab = "Valores Ajustados", ylab = "Resíduos",
main = "Resíduos vs Valores Ajustados",
pch = 19, col = "blue")
plot(valores_ajustados, residuos,
xlab = "Valores Ajustados", ylab = "Resíduos",
main = "Resíduos vs Valores Ajustados",
pch = 19, col = "blue")
plot(valores_ajustados, residuos,
xlab = "Valores Ajustados", ylab = "Resíduos",
main = "Resíduos vs Valores Ajustados",
pch = 19, col = "blue")
plot(valores_ajustados, residuos,
xlab = "Valores Ajustados", ylab = "Resíduos",
main = "Resíduos vs Valores Ajustados",
pch = 19, col = "blue")
# Modelo final selecionado
modelo_final <- lm(Y ~ X2, data = dados)
# Obter os resíduos e valores ajustados
residuos <- residuals(modelo_final)
valores_ajustados <- fitted(modelo_final)
par(mfrow = c(2, 3), mar = c(4, 4, 2, 2))
# 1. Resíduos vs Valores Ajustados
plot(valores_ajustados, residuos,
xlab = "Valores Ajustados", ylab = "Resíduos",
main = "Resíduos vs Valores Ajustados",
pch = 19, col = "blue")
abline(h = 0, col = "red", lwd = 2)
lines(lowess(valores_ajustados, residuos), col = "darkgreen", lwd = 2)
# 2. Q-Q Plot para Normalidade
qqnorm(residuos, main = "Q-Q Plot dos Resíduos", pch = 19, col = "blue")
qqline(residuos, col = "red", lwd = 2)
# 3. Scale-Location Plot
residuos_padronizados <- rstandard(modelo_final)
plot(valores_ajustados, sqrt(abs(residuos_padronizados)),
xlab = "Valores Ajustados", ylab = "√|Resíduos Padronizados|",
main = "Scale-Location Plot", pch = 19, col = "blue")
lines(lowess(valores_ajustados, sqrt(abs(residuos_padronizados))),
col = "darkgreen", lwd = 2)
# 4. Resíduos vs Variável Preditora (X2)
plot(dados$X2, residuos,
xlab = "Circunferência da Coxa (X2)", ylab = "Resíduos",
main = "Resíduos vs X2", pch = 19, col = "blue")
abline(h = 0, col = "red", lwd = 2)
lines(lowess(dados$X2, residuos), col = "darkgreen", lwd = 2)
# 5. Histograma dos Resíduos
hist(residuos, breaks = 10, freq = FALSE,
xlab = "Resíduos", main = "Distribuição dos Resíduos",
col = "lightblue", border = "black")
curve(dnorm(x, mean = mean(residuos), sd = sd(residuos)),
add = TRUE, col = "red", lwd = 2)
# 6. Resíduos vs Ordem de Coleta
plot(1:length(residuos), residuos, type = "b",
xlab = "Ordem de Coleta", ylab = "Resíduos",
main = "Resíduos vs Ordem", pch = 19, col = "blue")
abline(h = 0, col = "red", lwd = 2)
par(mfrow = c(1, 1))
# Teste de normalidade (Shapiro-Wilk)
teste_normalidade <- shapiro.test(residuos)
cat("Teste de Normalidade de Shapiro-Wilk:\n")
cat("W =", round(teste_normalidade$statistic, 4), "\n")
cat("p-valor =", round(teste_normalidade$p.value, 4), "\n")
# Teste de homocedasticidade (Breusch-Pagan)
library(lmtest)
teste_homocedasticidade <- bptest(modelo_final)
cat("\nTeste de Homocedasticidade de Breusch-Pagan:\n")
cat("BP =", round(teste_homocedasticidade$statistic, 4), "\n")
cat("p-valor =", round(teste_homocedasticidade$p.value, 4), "\n")
# Teste de independência dos resíduos (Durbin-Watson)
teste_independencia <- dwtest(modelo_final)
cat("\nTeste de Independência de Durbin-Watson:\n")
cat("DW =", round(teste_independencia$statistic, 4), "\n")
cat("p-valor =", round(teste_independencia$p.value, 4), "\n")
