cat("DW =", round(teste_independencia$statistic, 4), "\n")
cat("p-valor =", round(teste_independencia$p.value, 4), "\n")
# Calcular medidas de influência
leverage <- hatvalues(modelo_final)
residuos_student <- rstudent(modelo_final)
cook_distance <- cooks.distance(modelo_final)
# Definir pontos de corte
n <- nrow(dados)
p <- length(coef(modelo_final))
limite_leverage <- 2 * p / n
limite_cook <- 4 / (n - p)
# Identificar observações influentes
obs_influentes <- which(leverage > limite_leverage |
abs(residuos_student) > 2 |
cook_distance > limite_cook)
cat("Pontos de corte:\n")
cat("Leverage >", round(limite_leverage, 3), "\n")
cat("Cook's Distance >", round(limite_cook, 3), "\n")
cat("|Resíduos Studentizados| > 2\n\n")
cat("Observações potencialmente influentes:\n")
if(length(obs_influentes) > 0) {
dados_influentes <- data.frame(
Observacao = obs_influentes,
Leverage = round(leverage[obs_influentes], 3),
Residuos_Student = round(residuos_student[obs_influentes], 3),
Cook_Distance = round(cook_distance[obs_influentes], 3)
)
print(dados_influentes)
} else {
cat("Nenhuma observação influente identificada\n")
}
plot(cook_distance, type = "h",
xlab = "Índice da Observação", ylab = "Distância de Cook",
main = "Distância de Cook para Identificação de Pontos Influentes",
ylim = c(0, max(cook_distance) * 1.1))
abline(h = limite_cook, col = "red", lwd = 2, lty = 2)
text(which(cook_distance > limite_cook),
cook_distance[which(cook_distance > limite_cook)],
labels = which(cook_distance > limite_cook),
pos = 3, col = "red")
abline(h = limite_cook, col = "red", lwd = 2, lty = 2)
abline(h = limite_cook, col = "red", lwd = 2, lty = 2)
plot(cook_distance, type = "h",
xlab = "Índice da Observação", ylab = "Distância de Cook",
main = "Distância de Cook para Identificação de Pontos Influentes",
ylim = c(0, max(cook_distance) * 1.1))
estatisticas_residuos <- data.frame(
Estatistica = c("Média", "Desvio Padrão", "Mínimo", "Q1", "Mediana", "Q3", "Máximo"),
Valor = c(round(mean(residuos), 4),
round(sd(residuos), 4),
round(min(residuos), 4),
round(quantile(residuos, 0.25), 4),
round(median(residuos), 4),
round(quantile(residuos, 0.75), 4),
round(max(residuos), 4))
)
print(estatisticas_residuos, row.names = FALSE)
