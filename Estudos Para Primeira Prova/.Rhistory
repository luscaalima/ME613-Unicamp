# Gráfico comparativo
ggplot() +
# Pontos originais
geom_point(data = dados, aes(x = idade, y = y),
color = "gray", alpha = 0.6, size = 2) +
# Reta do modelo original
geom_line(data = retas, aes(x = idade, y = y_original),
color = "red", linewidth = 1.2, linetype = "solid") +
# Reta do modelo centrado (deverá ser IDÊNTICA)
geom_line(data = retas, aes(x = idade, y = y_centrado),
color = "blue", linewidth = 1.0, linetype = "dashed") +
# Linha vertical na média
geom_vline(xintercept = x_barra, color = "green",
linetype = "dashed", alpha = 0.7) +
# Ponto do intercepto centrado
geom_point(aes(x = x_barra, y = coef(fit2)[1]),
color = "darkblue", size = 4, shape = 18) +
# Labels e tema
labs(title = "Comparação: Modelo Original vs Modelo Centrado",
subtitle = "As retas são idênticas - apenas a interpretação do intercepto muda",
x = "Idade",
y = "Distância de Visão",
caption = paste("Reta vermelha: modelo original | Reta azul: modelo centrado\n",
"Linha verde: idade média (", round(x_barra, 1), " anos)")) +
theme_minimal()
