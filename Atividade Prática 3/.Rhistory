resumo2 <- summary(fit_x2)
resumo2 <- summary(fitx2)
comparativo <- data.frame(
Modelo = c("LifeExp ~ x1", "LifeExp ~ x2"),
R2 = c(resumo$r.squared, resumo2$r.squared),
R2_Ajustado = c(resumo$adj.r.squared, resumo2$adj.r.squared),
Erro_Padrao = c(resumo$sigma, resumo2$sigma)
)
knitr::kable(comparativo, caption = "Comparação dos Modelos Simples")
