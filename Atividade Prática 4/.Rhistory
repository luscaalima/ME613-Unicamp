Fonte   = c("Regressão", "Erro", "Total"),
gl      = c(df_reg, df_err, df_tot),
SQ      = c(SSR, SSE, SST),
QM      = c(MSR, MSE, NA),
F       = c(F, NA, NA),
`Pr(>F)`= c(p, NA, NA)
)
ANOVA_global
ANOVA_global
