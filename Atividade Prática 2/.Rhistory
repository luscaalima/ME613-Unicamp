library(tidyverse)
library(ggplot2)
library(readr)
library(tidyr)
library(stringr)
library(magrittr)
library(lubridate)
library(knitr)
library(dplyr)
library(kableExtra)
library(lmtest)
dados_hand <- readr::read_table("handheight.txt")
ggplot(dados_hand, aes(x = HandSpan, y = Height)) +
geom_point(alpha = 0.7) +
labs(x = "Largura do palmo (HandSpan, pol.)", y = "Altura (Height, pol.)",
title = "Dispersão: Altura vs Largura do Palmo")
