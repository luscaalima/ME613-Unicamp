geom_smooth(method = "lm",
se = TRUE,
color = "darkred",
fill = "lightcoral",
linewidth = 1) +
labs(title = "Relação entre Altura dos Pais e Filhos",
subtitle = "Dataset Galton - Regressão Linear",
x = "Altura Média dos Pais (polegadas)",
y = "Altura dos Filhos (polegadas)",
caption = "Fonte: Francis Galton, 1886") +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5),
plot.subtitle = element_text(hjust = 0.5))
