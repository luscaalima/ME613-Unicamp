n     <- 120
sumX  <- 2967
sumX2 <- 75739
sumY  <- 368.886
sumXY <- 9213.11
# Estadísticos muestrales
x_barra <- sumX / n
y_barra <- sumY / n
sxx <- sumX2 - (sumX^2) / n
sxy <- sumXY - (sumX * sumY) / n
# Estimadores OLS
beta1 <- sxy / sxx
beta0 <- y_barra - beta1 * x_barra
c(beta0 = beta0, beta1 = beta1)
beta1
sumX
sumY
sumY / n
sumX / n
n*x_barra
beta1 <- sxy / sxx
beta1
