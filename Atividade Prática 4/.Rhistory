modelo = lm(Y ~ X1+X2+X3,data = dados)
library(glue)
library(broom)
# Ajuste do modelo
modelo <- lm(Y ~ X1 + X2 + X3, data = dados)
# Extrai coeficientes
coeficientes <- tidy(modelo)
b0 <- coeficientes$estimate[1]
b1 <- coeficientes$estimate[2]
b2 <- coeficientes$estimate[3]
b3 <- coeficientes$estimate[4]
modelo
