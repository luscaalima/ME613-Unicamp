dados_com_outliers = read_csv("LifeExpectancyModificado.csv")
graficoX1_outliers <- dados_com_outliers %>% ggplot(aes(y = LifeExp, x = School,color=School))+
geom_point(size = 1.5, alpha = 0.4)+
