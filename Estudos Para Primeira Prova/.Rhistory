calcular_estimadores <- function(var_resposta,var_preditora){
numerador <- sum((x - mean(var_preditora)) * (y - mean(var_resposta)))
denominador <- sum((x - mean(var_preditora))^2)
beta1 <- numerador / denominador
beta0 <- mean(var_resposta) - (beta1 * mean(var_preditora))
return(c(beta0 = beta0, beta1 = beta1))
}
calcular_estimadores(dados$Age,dados$Distance)
calcular_estimadores <- function(var_resposta, var_preditora){
# Numerador e denominador
numerador <- sum((var_preditora - mean(var_preditora)) *
(var_resposta - mean(var_resposta)))
denominador <- sum((var_preditora - mean(var_preditora))^2)
# Coeficientes
beta1 <- numerador / denominador
beta0 <- mean(var_resposta) - beta1 * mean(var_preditora)
return(c(beta0 = beta0, beta1 = beta1))
}
calcular_estimadores(dados$Age,dados$Distance)
calcular_betas <- function(x, y) {
x_barra_2 <- mean(x)
y_barra_2 <- mean(y)
numerador <- sum((x - x_barra_2) * (y - y_barra_2))
denominador <- sum((x - x_barra_2)^2)
beta_1 <- numerador / denominador
beta_0 <- y_barra_2 - beta_1 * x_barra_2
return(c(beta0 = beta_0, beta1 = beta_1))
}
calcular_betas(dados$Age,dados$Distance)
calcular_betas <- function(x, y) {
x_barra_2 <- mean(x)
y_barra_2 <- mean(y)
numerador <- sum((x - x_barra_2) * (y - y_barra_2))
denominador <- sum((x - x_barra_2)^2)
beta_1 <- numerador / denominador
beta_0 <- y_barra_2 - beta_1 * x_barra_2
return(c(beta0 = beta_0, beta1 = beta_1))
}
